# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Kommagetrennt, nur für Web-Clients relevant (z. B. späteres Host-Dashboard)
CORS_ORIGINS=http://localhost:8081
ENABLE_API_DOCS=true

# ─── Datenbank (lokal: Werte aus `pnpm db:start`) ─────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Nur für Tests; Name muss auf _test enden, wird bei jedem Testlauf neu aufgebaut
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/parking_test

# ─── Supabase Auth / Storage ──────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
# Lokal signiert Supabase die Tokens mit HS256: "JWT secret" aus `npx supabase status`
# (Standardwert der lokalen CLI unten). In Produktion mit asymmetrischen Signing Keys leer lassen,
# dann werden die Public Keys automatisch über JWKS geladen.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# NIE in die App oder ins Repo! ("service_role key" / "Secret key" aus `supabase status`)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Adapter ──────────────────────────────────────────────
# dev = klar abgegrenzter Entwicklungsadapter, in production gesperrt
PAYMENT_PROVIDER=dev
# Nur mit PAYMENT_PROVIDER=stripe (Test-Keys aus dashboard.stripe.com -> Entwickler -> API-Schlüssel).
# Nie ins Git, nie im Chat teilen. Der pk_-Key darf in die App, der sk_-Key nie.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional lokal (Stripe CLI: stripe listen --forward-to localhost:4000/v1/webhooks/stripe), Pflicht in Produktion
STRIPE_WEBHOOK_SECRET=
# Auszahlung an Vermieter so viele Stunden nach Buchungsende
PAYOUT_DELAY_HOURS=24
STORAGE_PROVIDER=supabase
# Privater Bucket für Parkplatz-Fotos (wird beim ersten Upload automatisch angelegt)
STORAGE_BUCKET=spot-images

# ─── Marketplace ──────────────────────────────────────────
# Standard-Plattformgebühr für den Seed in Basispunkten (1500 = 15 %).
# Danach wird die Gebühr in der Tabelle platform_fee_rules gepflegt.
DEFAULT_PLATFORM_FEE_BPS=1500

# ─── In-App-Route ─────────────────────────────────────────
# openrouteservice (gratis, 2000 Routen/Tag, kommerziell erlaubt):
# Konto auf https://account.heigit.org erstellen -> API Key kopieren -> hier eintragen.
# Ohne Key zeigt die App den Fallback "In Apple/Google Maps öffnen".
ROUTING_PROVIDER=openrouteservice
ORS_API_KEY=
# Alternative mit Verkehrslage: ROUTING_PROVIDER=mapbox und MAPBOX_ACCESS_TOKEN=
# Der gleiche ORS_API_KEY wird auch für die Suche nach Geschäften/Orten und die Gehdistanz verwendet.

# ─── Echtzeit Luzern / Zug ────────────────────────────────
# Erst nach schriftlicher Zustimmung der Parkleitsystem-Betreiber auf true setzen (siehe README).
LIVE_LUZERN_ENABLED=false
LIVE_ZUG_ENABLED=false
