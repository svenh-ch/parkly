# Alle EXPO_PUBLIC_*-Werte landen im App-Bundle und sind damit ÖFFENTLICH.
# Hier niemals Secrets (Service-Role-Key, Stripe Secret Key, ...) eintragen.

# Leer lassen im Simulator/Expo-Dev: dann wird automatisch die IP des Entwicklungsrechners verwendet.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=

# "Publishable key" bzw. "anon key" aus `pnpm db:start` / `supabase status`
EXPO_PUBLIC_SUPABASE_ANON_KEY=
